
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Desktop.ViewModels"
        x:Class="Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="900"
        Height="600"
        Title="Westcoast Education">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="200,*">

        <Border Background="#151E3E" Padding="20">

            <StackPanel Spacing="20">

                <TextBlock Text="Westcoast Education"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>

                <Button Content="Kurser"
                        Command="{Binding GoToCoursesCommand}"
                        HorizontalAlignment="Stretch"/>

                <Button Content="Lägg till kurs"
                        Command="{Binding GoToAddCourseCommand}"
                        HorizontalAlignment="Stretch"/>
                
                <Button Content="Studenter"
                        Command="{Binding GoToStudentsCommand}"
                        HorizontalAlignment="Stretch"/>
                
                <Button Content="Lägg till student"
                        Command="{Binding GoToAddStudentCommand}"
                        HorizontalAlignment="Stretch"/>
                
                <Button Content="Lärare"
                        Command="{Binding GoToTeachersCommand}"
                        HorizontalAlignment="Stretch"/>




            </StackPanel>

        </Border>

        <ContentControl Grid.Column="1"
                        Margin="20"
                        Content="{Binding CurrentView}"/>

    </Grid>

</Window>
