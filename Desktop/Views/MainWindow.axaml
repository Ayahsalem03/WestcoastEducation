
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Desktop.ViewModels"
        x:Class="Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="900"
        Height="600"
        Title="Westcoast Education">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="200,*">

        <!-- Sidomeny -->
        <Border Background="{DynamicResource SidebarBackground}"
                Padding="20">

            <StackPanel Spacing="20">

                <TextBlock Text="Westcoast Education"
                           Foreground="{DynamicResource SidebarTextColor}"
                           FontSize="20"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>

                <Button Content="Kurser"
                        Command="{Binding GoToCoursesCommand}"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ButtonTextColor}"
                        HorizontalAlignment="Stretch"/>

                <Button Content="Lägg till kurs"
                        Command="{Binding GoToAddCourseCommand}"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ButtonTextColor}"
                        HorizontalAlignment="Stretch"/>

                <Button Content="Studenter"
                        Command="{Binding GoToStudentsCommand}"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ButtonTextColor}"
                        HorizontalAlignment="Stretch"/>

                <Button Content="Lägg till student"
                        Command="{Binding GoToAddStudentCommand}"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ButtonTextColor}"
                        HorizontalAlignment="Stretch"/>

                <Button Content="Lärare"
                        Command="{Binding GoToTeachersCommand}"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ButtonTextColor}"
                        HorizontalAlignment="Stretch"/>

                <Button Content="Lägg till lärare"
                        Command="{Binding GoToAddTeacherCommand}"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ButtonTextColor}"
                        HorizontalAlignment="Stretch"/>

            </StackPanel>

        </Border>

        <!-- Huvudinnehåll -->
        <Border Grid.Column="1"
                Background="{DynamicResource MainBackground}"
                Padding="20">

            <ContentControl Content="{Binding CurrentView}"/>

        </Border>

    </Grid>

</Window>
